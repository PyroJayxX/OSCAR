# LLM Provider: "ollama" (default) or "groq"
LLM_PROVIDER=ollama

# Ollama settings
OLLAMA_URL=http://localhost:11434
OSCAR_MODEL_NAME=qwen3.5:9b

# Groq settings (required if LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_GRADING_MODEL=llama-3.3-70b-versatile

# Piper TTS (local)
PIPER_VOICE=en_US-lessac-medium
PIPER_MODEL_DIR=./piper_models

# Whisper STT
OSCAR_WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE_HINT=en

# Database
OSCAR_DB_PATH=./oscar.db
OSCAR_QUESTIONS_PATH=./app/data/questions.json

# Timer (seconds per difficulty)
DEFAULT_TIMER_SECONDS=90
TIMER_EASY=120
TIMER_MEDIUM=90
TIMER_HARD=60

# CORS
OSCAR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173